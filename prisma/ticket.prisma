model Ticket {
  id                 String          @id @default(uuid(7))
  ticketId           String          @unique
  seq                Int             @unique @default(autoincrement())
  userId             String
  user               User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  shipmentId         String?
  shipment           Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  tripId             String?
  trip               Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  category           String          // "PAYMENT" | "DELIVERY" | "KYC" | "TECHNICAL" | "OTHER"
  title              String
  description        String
  attachments        String[]        @default([])
  status             String          @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  priority           String          @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  assigneeId         String?
  assignee           User?           @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  slaFirstResponseAt DateTime?
  slaResolvedAt      DateTime?
  comments           TicketComment[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("tickets")
}

model TicketComment {
  id          String   @id @default(uuid(7))
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  attachments String[] @default([])
  createdAt   DateTime @default(now())

  @@map("ticket_comments")
}
