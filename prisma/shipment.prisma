model ShipmentCategory {
  id          String     @id @default(uuid(7))
  name        String
  slug        String     @unique
  maxWeight   Float?
  minPrice    Float
  maxPrice    Float?
  maxQuantity Int?
  shipments   Shipment[]

  @@map("shipment_categories")
}

enum ShipmentStatus {
  AWAITING_MATCH
  ACTIVE
  DELIVERED
  CANCELED
}

model Shipment {
  id           String   @id @default(uuid(7))
  itemName     String
  weight       Float
  quantity     Int
  description  String
  itemPhotos   String[]
  instructions String

  fromCountry String
  toCountry   String

  pricePerKg Float

  receiverName    String
  receiverPhone   String
  receiverAddress String

  category   ShipmentCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  trip   Trip?  @relation(fields: [tripId], references: [id])
  tripId String?
  bagType String? // cabin or checkIn

  status        ShipmentStatus @default(AWAITING_MATCH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}
