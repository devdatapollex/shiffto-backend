model ShipmentCategory {
  id          String     @id @default(uuid(7))
  name        String
  slug        String     @unique
  maxWeight   Float?
  minPrice    Float
  maxPrice    Float?
  maxQuantity Int?
  shipments   Shipment[]

  @@map("shipment_categories")
}

enum ShipmentStatus {
  AWAITING_MATCH
  ACTIVE
  DELIVERED
  CANCELED
}

model Shipment {
  id              String           @id @default(uuid(7))
  itemName        String
  weight          Float
  quantity        Int
  description     String
  itemPhotos      String[]
  instructions    String
  fromCountry     String
  toCountry       String
  pricePerKg      Float
  receiverName    String
  receiverPhone   String
  receiverAddress String
  categoryId      String
  userId          String
  tripId          String?
  bagType         String?
  category        ShipmentCategory @relation(fields: [categoryId], references: [id])
  trip            Trip?            @relation(fields: [tripId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  status        ShipmentStatus @default(AWAITING_MATCH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}
