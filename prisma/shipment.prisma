model ShipmentCategory {
  id          String     @id @default(uuid(7))
  name        String
  slug        String     @unique
  maxWeight   Float?
  minPrice    Float
  maxPrice    Float?
  maxQuantity Int?
  shipments   Shipment[]

  @@map("shipment_categories")
}

enum ShipmentStatus {
  AWAITING_MATCH
  ACTIVE
  DELIVERED
  CANCELED
}

model Shipment {
  id              String           @id @default(uuid(7))
  itemName        String
  weight          Float
  quantity        Int
  description     String
  itemPhotos      String[]
  instructions    String
  fromCountry     String
  toCountry       String
  pricePerKg      Float
  receiverName    String
  receiverPhone   String
  receiverAddress String
  categoryId      String
  userId          String
  tripId          String?
  bagType         String?
  category        ShipmentCategory @relation(fields: [categoryId], references: [id])
  trip            Trip?            @relation(fields: [tripId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  status ShipmentStatus @default(AWAITING_MATCH)

  shipmentSteps      ShipmentStep[]      @relation("ShipmentSteps")
  offers             Offer[]
  tickets            Ticket[]
  paymentTransaction PaymentTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

enum shipmentStepStage {
  PAYMENT_CONFIRMED
  PICKED_UP
  CHECKED_IN
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
}

model StepDefinition {
  id          String            @id @default(uuid(7))
  stage       shipmentStepStage @unique
  label       String
  order       Int               @unique
  description String?
  steps       ShipmentStep[]    @relation("StepDefinitions")

  @@map("step_definitions")
}

model ShipmentStep {
  id         String   @id @default(uuid(7))
  shipment   Shipment @relation("ShipmentSteps", fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String

  definition   StepDefinition    @relation("StepDefinitions", fields: [definitionId], references: [id])
  definitionId String
  stage        shipmentStepStage

  order       Int
  completedAt DateTime?
  isCurrent   Boolean   @default(false)
  notes       String?
  photoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentId], where: { isCurrent: true }, map: "shipment_steps_one_current_per_shipment")
  @@unique([shipmentId, order])
  @@index([shipmentId, order])
  @@index([shipmentId, isCurrent])
  @@map("shipment_steps")
}

enum OfferStatus {
  PENDING
  PAYMENT_PENDING
  ACCEPTED
  REJECTED
  PAYMENT_CANCELED
  EXPIRED
}

model Offer {
  id                  String               @id @default(uuid(7))
  shipmentId          String
  travellerId         String
  tripId              String
  senderPrice         Float // Snapshot of shipment's pricePerKg at time of offer
  offeredPrice        Float // What the traveller is offering to pay
  bagType             String // "cabin" | "checkIn"
  status              OfferStatus          @default(PENDING)
  isCounterOffer      Boolean              @default(false)
  shipment            Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  traveller           User                 @relation("TravellerOffers", fields: [travellerId], references: [id])
  trip                Trip                 @relation(fields: [tripId], references: [id])
  paymentTransactions PaymentTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([shipmentId, travellerId]) // One active offer per traveller per shipment
  @@unique([shipmentId], where: raw("status IN ('PAYMENT_PENDING', 'ACCEPTED')"), map: "unique_active_or_pending_offer_per_shipment")
  @@index([shipmentId])
  @@index([travellerId])
  @@map("offers")
}
