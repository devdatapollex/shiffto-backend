model Trip {
  id                       String     @id @default(uuid(7))
  flightNumber             String
  fromCountry              String
  toCountry                String
  flightDate               DateTime
  flightTime               String     // Format: "HH:mm" or "hh:mm a"
  airportArrivalTime       String?    // Optional because it's in PRD but not in the UI design
  cabinBagCapacity         Float      // Cabin bag capacity in KG
  checkInBagCapacity       Float      // Check-in bag capacity in KG
  remainingCabinCapacity   Float
  remainingCheckInCapacity Float
  ticketPhoto              String     // URL to the uploaded ticket photo
  status                   String     @default("PENDING") // PENDING, ACTIVE, COMPLETED, CANCELLED, REJECTED
  rejectionReason          String?

  // Relations
  user                     User       @relation(fields: [userId], references: [id])
  userId                   String
  shipments                Shipment[]

  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@map("trips")
}
