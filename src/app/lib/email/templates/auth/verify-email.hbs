{{> header subject=subject}}

<!-- Content -->
<tr>
  <td style="padding: 48px 40px;">
    <h2 style="margin: 0 0 24px 0; color: #1A2647; font-size: 22px; font-weight: 600;">
      Verify your email
    </h2>
    <p style="margin: 0 0 24px 0; color: #4B5563; font-size: 15px; line-height: 1.7;">
      Thanks for signing up for Shiffto! Please use the verification code below to complete your registration.
    </p>

    <!-- OTP Box -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td align="center" style="padding: 24px 0;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="background-color: #FFF7ED; border: 2px dashed #E06B1A; border-radius: 12px; padding: 24px 48px;">
            <tr>
              <td style="padding: 12px 24px;">
                <p style="margin: 0 0 8px 0; color: #9CA3AF; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; text-align: center;">
                  Your verification code
                </p>
                <p style="margin: 0; color: #E06B1A; font-size: 36px; font-weight: 700; letter-spacing: 6px; text-align: center; font-family: 'Fira Code', monospace;">
                  {{otp}}
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>

    <p style="margin: 24px 0 0 0; color: #6B7280; font-size: 14px; line-height: 1.6;">
      This code expires in <strong style="color: #1A2647;">5 minutes</strong>. If you didn't create an account, you can safely ignore this email.
    </p>
  </td>
</tr>

{{> footer email=email year=year}}
